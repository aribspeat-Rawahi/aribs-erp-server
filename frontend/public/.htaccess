<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If the request is for an actual file or directory that exists
  # (index.html, assets/*, favicon.svg), serve it directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise (e.g. /invoices, /quotations, /settings), hand it to
  # index.html so React Router can render the right page client-side.
  RewriteRule ^ index.html [L]
</IfModule>
