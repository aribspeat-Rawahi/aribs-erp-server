DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_DATABASE=erp_db
# Auto-creates/updates DB tables from entities on startup. Leave as true
# until you've confirmed your production schema is fully up to date (no
# migration system exists in this project), then set to false to stop
# schema auto-sync in production.
DB_SYNCHRONIZE=true
PORT=3000

# Comma-separated list of allowed CORS origins, e.g.
# https://app.aribs.net,https://admin.aribs.net
# Defaults to * (any origin) if unset so current deploys keep working.
CORS_ALLOWED_ORIGINS=https://app.aribs.net

COMPANY_NAME=ARIBS Palm Peat
COMPANY_VATIN=OM1000000000
INVOICE_UPLOAD_DIR=./uploads/invoices
LOGO_PATH=./assets/logo.jpg
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=erp@aribs.net
VAT_EXCLUDE_NOTIFY_EMAILS=ceo@aribs.net,md@aribs.net,accountant@aribs.net
CUSTOMER_DELETE_NOTIFY_EMAILS=ceo@aribs.net,md@aribs.net,gm@aribs.net
# Optional — falls back to CUSTOMER_DELETE_NOTIFY_EMAILS if unset.
# SUPPLIER_DELETE_NOTIFY_EMAILS=ceo@aribs.net,md@aribs.net,gm@aribs.net

# Payment Reminder Automation (CRM Step 5) — all optional, sensible
# defaults are used if left blank. Set PAYMENT_REMINDER_ENABLED=false to
# turn the daily cron job off entirely without removing config.
# PAYMENT_REMINDER_ENABLED=true
# PAYMENT_REMINDER_DUE_SOON_DAYS=3
# PAYMENT_REMINDER_OVERDUE_DAYS=1,7,15,30
# PAYMENT_REMINDER_NOTIFY_DAYS=30
PAYMENT_REMINDER_NOTIFY_EMAILS=accountant@aribs.net

# Approval Workflow (CRM Step 7) — all optional, sensible defaults used
# if left blank.
# DISCOUNT_APPROVAL_THRESHOLD_PERCENT=10
APPROVAL_NOTIFY_EMAILS=ceo@aribs.net,md@aribs.net,accountant@aribs.net

# Recurring Invoice (CRM Step 8) — set to false to pause the daily
# auto-generation cron without deleting any recurring invoice templates.
# RECURRING_INVOICE_ENABLED=true
JWT_SECRET=ekta-lomba-random-string-emon-dao
LOGO_UPLOAD_DIR=./uploads/branding
