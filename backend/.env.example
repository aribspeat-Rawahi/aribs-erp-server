DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_DATABASE=erp_db
# Database schema is managed by migrations (src/migrations), which run
# automatically when the app starts. DB_SYNCHRONIZE is no longer used.
# Optional: force the TypeORM driver (auto-detected from the server).
# DB_TYPE=mariadb
PORT=3000

# Comma-separated list of allowed CORS origins, e.g.
# https://app.aribs.net,https://admin.aribs.net
# Defaults to * (any origin) if unset so current deploys keep working.
CORS_ALLOWED_ORIGINS=https://app.aribs.net

COMPANY_NAME=ARIBS Palm Peat
COMPANY_VATIN=OM1000000000
INVOICE_UPLOAD_DIR=./uploads/invoices
LOGO_PATH=./assets/logo.jpg
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=erp@aribs.net
VAT_EXCLUDE_NOTIFY_EMAILS=ceo@aribs.net,md@aribs.net,accountant@aribs.net
CUSTOMER_DELETE_NOTIFY_EMAILS=ceo@aribs.net,md@aribs.net,gm@aribs.net
# Optional — falls back to CUSTOMER_DELETE_NOTIFY_EMAILS if unset.
# SUPPLIER_DELETE_NOTIFY_EMAILS=ceo@aribs.net,md@aribs.net,gm@aribs.net

# Payment Reminder Automation (CRM Step 5) — all optional, sensible
# defaults are used if left blank. Set PAYMENT_REMINDER_ENABLED=false to
# turn the daily cron job off entirely without removing config.
# PAYMENT_REMINDER_ENABLED=true
# PAYMENT_REMINDER_DUE_SOON_DAYS=3
# PAYMENT_REMINDER_OVERDUE_DAYS=1,7,15,30
# PAYMENT_REMINDER_NOTIFY_DAYS=30
PAYMENT_REMINDER_NOTIFY_EMAILS=accountant@aribs.net

# Approval Workflow (CRM Step 7) — all optional, sensible defaults used
# if left blank.
# DISCOUNT_APPROVAL_THRESHOLD_PERCENT=10
APPROVAL_NOTIFY_EMAILS=ceo@aribs.net,md@aribs.net,accountant@aribs.net

# Recurring Invoice (CRM Step 8) — set to false to pause the daily
# auto-generation cron without deleting any recurring invoice templates.
# RECURRING_INVOICE_ENABLED=true
JWT_SECRET=ekta-lomba-random-string-emon-dao
LOGO_UPLOAD_DIR=./uploads/branding

# --- Deployment (Hostinger Git auto-deploy) ---------------------------------
# Persistent folder OUTSIDE the app directory for uploads, invoice PDFs and
# backups. Every Git deploy rebuilds the app folder, so this MUST be set on
# the server, e.g. /home/u123456789/erp-data  (staging: .../erp-data-staging)
# Leave empty for local development.
DATA_DIR=
# Optional: where the built frontend lives. Defaults to ../frontend/dist,
# which is correct for this repo layout - normally leave empty.
FRONTEND_DIST_DIR=

# --- Secure PDF links (sent inside WhatsApp messages) -----------------------
# Public address of THIS site - used to build links like
# https://erp.aribs.net/api/public/documents/<token>
# Staging: https://staging-erp.aribs.net . Leave empty to send no link.
PUBLIC_BASE_URL=
# Long random string used to sign the links (different per environment).
# Falls back to JWT_SECRET if empty.
DOCUMENT_LINK_SECRET=
# How long a link keeps working (days, max 90). Default 7.
DOCUMENT_LINK_TTL_DAYS=7
# Country code added to local phone numbers in WhatsApp links
# (e.g. 9552 2725 -> 968 9552 2725). Default 968 (Oman).
DEFAULT_PHONE_COUNTRY_CODE=968

# ---- Off-site backup (Cloudflare R2 or any S3-compatible storage) ----
# Leave empty to switch it off. When set, the nightly 03:00 backup also
# uploads an ENCRYPTED copy of the database + all uploaded files.
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
OFFSITE_BACKUP_ENDPOINT=
OFFSITE_BACKUP_BUCKET=
OFFSITE_BACKUP_ACCESS_KEY_ID=
OFFSITE_BACKUP_SECRET_ACCESS_KEY=
# Encryption passphrase (min 16 characters). KEEP A COPY OUTSIDE THE SERVER -
# without it the backups can never be opened.
OFFSITE_BACKUP_PASSPHRASE=
# Folder inside the bucket, e.g. production / staging (default: erp)
OFFSITE_BACKUP_PREFIX=
# Who gets an email if the off-site backup fails (comma-separated; needs SMTP_*)
OFFSITE_BACKUP_ALERT_EMAILS=

# ---- Error alerts ----
# Who gets an email when something breaks in production (server errors,
# failed background jobs, page crashes in the app). Comma-separated.
# Falls back to OFFSITE_BACKUP_ALERT_EMAILS. Needs the SMTP_* settings above.
ERROR_ALERT_EMAILS=
