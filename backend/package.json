{
  "name": "erp-backend",
  "version": "0.1.0",
  "description": "Manufacturing ERP backend - Aribs",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "check:permissions": "node scripts/check-module-access.js",
    "typeorm": "typeorm -d dist/data-source.js",
    "migration:generate": "nest build && typeorm -d dist/data-source.js migration:generate",
    "migration:create": "typeorm migration:create",
    "migration:run": "nest build && typeorm -d dist/data-source.js migration:run",
    "migration:revert": "nest build && typeorm -d dist/data-source.js migration:revert",
    "migration:show": "nest build && typeorm -d dist/data-source.js migration:show",
    "migration:check": "nest build && typeorm -d dist/data-source.js migration:generate src/migrations/Unused --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "multer": "^2.4.0",
    "mysql2": "^3.11.0",
    "mysqldump": "^3.2.0",
    "nodemailer": "^10.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tar": "^7.5.22",
    "typeorm": "^0.3.20"
  },
  "overrides": {
    "multer": "^2.4.0",
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "mysqldump": {
      "mysql2": "^3.24.4"
    }
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.5.4"
  }
}
